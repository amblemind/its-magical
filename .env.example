# Copy to .env.local and fill in. Never commit the filled-in file.

# Hosted headless Chrome that loads the target page and returns the screenshot.
# Get a token at https://browserless.io
BROWSERLESS_TOKEN=

# S3 bucket the finished screenshots are written to, and the credentials used
# to write them. The IAM user needs only s3:PutObject and s3:GetObject on this
# one bucket -- do not reuse a broadly scoped key here.
AWS_ACCESS=
AWS_SECRET=
AWS_BUCKET=
AWS_REGION=us-east-1
